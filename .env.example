# --- Core ---
# Port for the web UI and API
PORT=8080
# Bind address. Use 0.0.0.0 to expose on the network, 127.0.0.1 behind a reverse proxy.
HOST=0.0.0.0
# Secret used to sign session JWTs. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session lifetime in hours (server-side enforced)
SESSION_TTL_HOURS=12

# --- Cookies ---
# Secure cookies are ON by default. Modern browsers accept Secure cookies on
# http://localhost, so local dev works. Only set to "false" if you must test
# over plain http on a LAN address (never in production).
COOKIE_SECURE=true

# --- Storage roots (production values shown; dev falls back to ./data/*) ---
# Mount your 250 GB SSD at /srv/web (see README) and use these:
STORAGE_ROOT=/srv/web/storage
SFTP_ROOT=/srv/web/sftp
REPOS_ROOT=/srv/web/repos
# App data (SQLite db, host key, temp uploads). Keep on the same disk as STORAGE_ROOT
# so uploads can be moved into place without a cross-device copy.
DATA_DIR=/srv/web/data

# --- Bootstrap admin ---
# Used only on first run when the users table is empty. If unset, a random
# password is generated and printed to the console once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Uploads / quotas ---
# Max size of a single uploaded file, in bytes (default 2 GiB)
MAX_UPLOAD_BYTES=2147483648
# Default per-user quota in bytes when an admin does not set one (default 10 GiB)
DEFAULT_QUOTA_BYTES=10737418240

# --- SFTP ---
SFTP_ENABLED=true
SFTP_PORT=2222
# Hostname shown to users on the SFTP page (defaults to the web request host)
SFTP_PUBLIC_HOST=

# --- GitHub puller ---
# Only https://github.com/... URLs are accepted unless you relax this.
GIT_ALLOW_ANY_HTTPS_HOST=false
# Hard timeout for a clone/pull in seconds
GIT_TIMEOUT_SECONDS=300

# --- Behind a reverse proxy? ---
# Set to true when running behind nginx/caddy so rate limiting sees real client IPs.
TRUST_PROXY=false
